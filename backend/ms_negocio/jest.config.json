{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".*\\.spec\\.ts$",
  "extensionsToTreatAsEsm": [".ts"],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": {
          "module": "ESNext",
          "moduleResolution": "Bundler"
        }
      }
    ]
  },
  "setupFiles": ["reflect-metadata"],
  "setupFilesAfterEnv": ["<rootDir>/jest.setup.mjs"],
  "testEnvironment": "node"
}
