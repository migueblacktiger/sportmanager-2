              "raw": "{\n  \"token\": \"token-iphone-14-pro\",\n  \"expiration\": \"2026-12-29T18:30:00\",\n  \"code2FA\": \"381924\"\n}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}/sessions"
          }
        },
        {
          "name": "Listar sesiones del usuario",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/{{userId}}/sessions"
