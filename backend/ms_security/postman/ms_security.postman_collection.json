              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"token-computador-personal\",\n  \"expiration\": \"2026-12-30T10:00:00\",\n  \"code2FA\": \"794215\"\n}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}/sessions/{{sessionId}}"
          }
        },
        {
          "name": "Eliminar sesión",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/users/{{userId}}/sessions/{{sessionId}}"
          }
        }
      ]
